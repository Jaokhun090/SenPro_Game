# ============================================================
#  Unity .gitignore
#  สำหรับโปรเจกต์: SenPro_Game (Exergame การทรงตัวผู้สูงอายุ)
# ============================================================

# ─── โฟลเดอร์ที่ Unity สร้างเองอัตโนมัติ (ขนาดใหญ่ ไม่ควร push) ───
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# ─── Autogenerated VS/Rider files ─────────────────────────
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vscode/

# ─── OS generated ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ─── ไฟล์ Build output ─────────────────────────────────────
*.apk
*.aab
*.unitypackage
*.app

# ─── crashlytics ───────────────────────────────────────────
crashlytics-build.properties

# ─── ไฟล์ที่ควร PUSH ขึ้น GitHub (ไม่ถูก ignore) ───────────
# /Assets/         ← Scripts, Sprites, Scenes, Prefabs ทั้งหมด ✅
# /Packages/       ← package dependencies ✅
# /ProjectSettings/ ← Unity project config ✅
